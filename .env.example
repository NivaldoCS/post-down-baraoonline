# Copie para .env NO SERVIDOR (o .env nunca vai para o GitHub).
# Gere os dois valores abaixo com:  docker compose run --rm app python -m app.hash_password
# Use aspas simples: o hash contém o caractere $.
APP_PASSWORD_HASH=''
SESSION_SECRET=''

# Domínio público (usado pelo Caddy para emitir HTTPS automaticamente)
DOMAIN=postdown.seudominio.com.br
# Hosts aceitos pelo servidor (separados por vírgula). Deixe vazio para aceitar qualquer.
TRUSTED_HOSTS=postdown.seudominio.com.br

# true em produção (HTTPS). Use false apenas para testes locais em http://localhost.
COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200

# Limites
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_SESSION=3
MAX_EXTRACTIONS_PER_MINUTE=6
MAX_ITEMS_PER_POST=20
MAX_FILE_MB=500
MAX_ZIP_MB=1024
MAX_VIDEO_SECONDS=1800
EXTRACT_TIMEOUT_SECONDS=45
DOWNLOAD_TIMEOUT_SECONDS=180
JOB_TTL_SECONDS=900

# Opcional — NÃO é senha. Caminho (dentro do contêiner) de um arquivo de cookies
# no formato Netscape de uma conta secundária do Instagram. Só use se o acesso
# anônimo for bloqueado com frequência. Ver README antes de ativar.
INSTAGRAM_COOKIES_FILE=
